                    sui_transaction_builder::Function::new(
                            PACKAGE_ID,
                            Identifier::from_static(MODULE_NAME),
                            Identifier::from_static("singleton"),
                        )
                        .with_type_args(vec![T0::type_()]),
                    vec![p0.into()],
                )
                .into()
        }
    }
}
